#!/usr/bin/env sh
set -eu

message_file="$1"
first_line="$(sed -n '1p' "$message_file")"

case "$first_line" in
  feat:\ *|fix:\ *|docs:\ *|chore:\ *|refactor:\ *|test:\ *|ops:\ *|data:\ *|build:\ *|ci:\ *|perf:\ *|style:\ *|revert:\ *)
    exit 0
    ;;
  *)
    echo "Commit message must use Conventional Commits."
    echo "Example: feat: add encrypted sharing"
    exit 1
    ;;
esac
