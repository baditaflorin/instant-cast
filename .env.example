# Frontend build-time configuration
VITE_APP_VERSION=0.1.0
VITE_COMMIT_SHA=local
VITE_API_BASE_URL=http://localhost:8080

# Backend runtime configuration
APP_ENV=development
APP_ADDR=:8080
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_ALLOWED_ORIGINS=http://localhost:5173,https://baditaflorin.github.io
APP_UPLOAD_DIR=runtime-data/uploads
APP_SIGNING_SECRET=replace-with-at-least-32-random-bytes
APP_MAX_UPLOAD_BYTES=524288000
APP_DEFAULT_TTL_SECONDS=604800
